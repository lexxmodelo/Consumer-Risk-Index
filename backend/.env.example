# Database Configuration
USE_DATABASE=true
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/consumerriskindex
DB_MAX_CONNECTIONS=20

# FRED API Configuration
FRED_API_KEY=your_fred_api_key_here
FRED_RATE_LIMIT=120

# Server Configuration
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Cache Configuration
CACHE_TTL=3600
FILE_CACHE_ENABLED=true

# Security
CORS_ORIGINS=["*"]
ADMIN_API_TOKEN=your_admin_token_here
